# Nexus Core MVP1 Environment Variables
# Reference: DEPLOYMENT_v1.0.md Section 3
# Task ID: PHASE0-INIT-005
#
# Copy this file to .env and configure for your environment.
# DO NOT commit .env to version control.

# =============================================================================
# CORE CONFIGURATION (Required)
# =============================================================================

# Database connection string (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://nexus:nexus@nexus_db:5432/nexus_core

# Path to Transfer Station on host machine
# Windows default: E:\Transfer_Station
# Linux/Mac: /path/to/transfer_station
# Container path is always: /transfer_station
TRANSFER_STATION_PATH=E:\Transfer_Station

# Ingestion worker polling interval in seconds (default: 60)
INGESTION_WORKER_POLL_INTERVAL=60

# =============================================================================
# SECURITY CONFIGURATION (Required for Production)
# =============================================================================

# JWT public key for token validation (RSA PEM format)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PUBLIC_KEY=

# JWT private key for token signing (RSA PEM format, API only)
JWT_PRIVATE_KEY=

# JWT issuer identifier
JWT_ISSUER=nexus-core-api

# =============================================================================
# EXTRACTION TOOLS (Required)
# =============================================================================

# Docling version (format: docling/{semver})
# Minimum: docling/1.0.0 (TOOL_VERSIONS_v1.0.md)
DOCLING_VERSION=docling/1.0.0

# Unstructured version (format: unstructured/{semver})
# Minimum: unstructured/0.10.0 (TOOL_VERSIONS_v1.0.md)
UNSTRUCTURED_VERSION=unstructured/0.10.0

# =============================================================================
# OPENAI CONFIGURATION (Required)
# =============================================================================

# OpenAI API key for embeddings and synthesis
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# OpenAI embedding model
# Default: text-embedding-3-small (1536 dimensions)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI chat model for query synthesis
# Default: gpt-4
OPENAI_CHAT_MODEL=gpt-4

# =============================================================================
# EMBEDDINGS (Required)
# =============================================================================

# Embedding model (now using OpenAI)
# Default: text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small

# Embedding vector dimensions (must match model)
# Default: 1536 (for text-embedding-3-small)
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# QUERY & RETRIEVAL (Optional)
# =============================================================================

# Number of top results to retrieve per query
RETRIEVAL_TOP_K=10

# Minimum tokens for keyword vs vector retrieval decision
RETRIEVAL_KEYWORD_THRESHOLD=10

# Keyword weight in hybrid retrieval (0.0-1.0)
# 0.5 = equal weighting between keyword and vector
RETRIEVAL_HYBRID_ALPHA=0.5

# =============================================================================
# LOGGING (Optional)
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# DEVELOPMENT ONLY (Do not use in production)
# =============================================================================

# Enable debug mode (additional logging, stack traces)
# DEBUG_MODE=false

# Disable health check retries (faster startup for development)
# HEALTH_CHECK_RETRIES=1
